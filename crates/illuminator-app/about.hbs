<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>Illuminator: Third party licenses</title>
        <style>
            body { max-width: 800px; margin: 0 auto; padding: 16px; }
            pre { white-space: pre-wrap; max-height: 240px; overflow-y: auto; }
            @media (prefers-color-scheme: dark) {
                body { background: #222; color: #ddd; }
                a { color: skyblue; }
            }
        </style>
    </head>
    <body>
        <h1>Third party licenses</h1>
        <p>Illuminator is built with the help of these open source projects:</p>
        <p>Icons: <a href="https://www.carbondesignsystem.com/building-blocks/foundations/icons/library">IBM Carbon Design System</a>, copyright IBM Corp., under the Apache License 2.0 below.</p>

        <h2>Overview</h2>
        <ul>
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        {{#each licenses}}
        <h2 id="{{id}}">{{name}}</h2>
        <p>
            Used by:
            {{#each used_by}}
            <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a> {{#unless @last}},{{/unless}}
            {{/each}}
        </p>
        <pre>{{text}}</pre>
        {{/each}}
    </body>
</html>
