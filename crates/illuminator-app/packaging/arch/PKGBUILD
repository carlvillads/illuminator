# Maintainer: Carl Villads Priisholm <me@cvrp.dk>
pkgname=illuminator
pkgver=0.2.0
pkgrel=1
pkgdesc='Fast medical volume viewer'
arch=('x86_64')
url='https://github.com/carlvillads/illuminator'
license=('Apache-2.0 OR MIT')
depends=(
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-driver'
  'vulkan-icd-loader'
  'wayland'
)
options=('!debug' '!strip')
source=("$pkgname-$pkgver.tar.gz" 'illuminate')
sha256sums=('SKIP' 'SKIP')

package() {
  cd "$pkgname-$pkgver"
  local packaging_directory=crates/illuminator-app/packaging/linux

  install -Dm755 "$srcdir/illuminate" -t "$pkgdir/usr/bin"
  install -Dm644 "$packaging_directory/io.github.carlvillads.illuminator.metainfo.xml" \
    -t "$pkgdir/usr/share/metainfo"
  install -Dm644 "$packaging_directory/nifti.xml" "$pkgdir/usr/share/mime/packages/illuminator.xml"
  for size in 32 48 64 128 256 512; do
    install -Dm644 "$packaging_directory/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/illuminate.png"
  done
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/illuminate.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Illuminator
Comment=Fast medical volume viewer
Categories=Science;MedicalSoftware;
Icon=illuminate
Exec=illuminate %F
Terminal=false
MimeType=image/x-nifti;
StartupWMClass=illuminator
EOF
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}